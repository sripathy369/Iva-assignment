        st.plotly_chart(pf, use_container_width=True)

    with calc2:
        st.markdown("### ② Pixel × Kernel")
        mf = go.Figure(data=go.Heatmap(z=multiplication, text=np.round(multiplication, 2), texttemplate="%{text}", colorscale="Blues", showscale=False))
        mf.update_layout(height=220, margin=dict(l=10, r=10, t=5, b=5), font=dict(family="Times New Roman", size=16))
