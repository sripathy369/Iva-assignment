    for dx in [-1,0,1]:
        for dy in [-1,0,1]:
            fig.add_shape(type="rect", x0=c+dx-.5, x1=c+dx+.5, y0=r+dy-.5, y1=r+dy+.5, line=dict(color="#ff3158", width=2), fillcolor="rgba(255,50,80,.05)")

    fig.add_shape(type="rect", x0=c-.5, x1=c+.5, y0=r-.5, y1=r+.5, line=dict(color="#00d4ff", width=4), fillcolor="rgba(0,212,255,.10)")
    fig.update_layout(height=430, margin=dict(l=35, r=15, t=8, b=30), xaxis=dict(title=dict(text="Column (X)", font=dict(family="Times New Roman", size=14)), showgrid=False, autorange="reversed"), yaxis=dict(title=dict(text="Row (Y)", font=dict(family="Times New Roman", size=14)), showgrid=False, scaleanchor="x", scaleratio=1, autorange="reversed"), font=dict(family="Times New Roman", size=13))

    events = plotly_events(fig, hover_event=True, click_event=False, select_event=False, override_height=430, override_width="100%", key="live_image")
    if events:
        event = events[-1]
        if "x" in event and "y" in event:
            nc = max(1, min(int(round(event["x"])), image_array.shape[1]-2))
            nr = max(1, min(int(round(event["y"])), image_array.shape[0]-2))
            st.session_state.cursor_col = nc
            st.session_state.cursor_row = nr
            st.rerun()

with calculation_col:
    st.markdown('<div class="section-title">🧮 Live Kernel Calculation</div>', unsafe_allow_html=True)
    pixel_block = image_array[r-1:r+2, c-1:c+2].astype(float)
    multiplication = pixel_block * kernel
    convolution_sum = np.sum(multiplication)
    final_pixel = np.clip(abs(convolution_sum), 0, 255)

    calc1, calc2, calc3 = st.columns([1, 1, 0.8])

    with calc1:
        st.markdown("### ① Selected Pixels")
        pf = go.Figure(data=go.Heatmap(z=pixel_block, text=pixel_block.astype(int), texttemplate="%{text}", colorscale="Greys", showscale=False))
